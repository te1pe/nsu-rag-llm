# Copy to .env and edit. Every value below is the built-in default, so an
# empty .env behaves identically to this file.
# Generated from nsu_rag_llm.config.Settings - a test fails if they drift.

# --- Answering LLM. Any OpenAI-compatible endpoint; Ollama by default.
# From inside a container use http://host.docker.internal:11434/v1
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3.5-9b-8k
LLM_API_KEY=ollama
LLM_TIMEOUT_SECONDS=120.0

# --- Sampling. Kept here rather than in ollama/Modelfile so that phase 4
# compares models under identical sampling. qwen3.5 defaults to
# temperature 1 and presence_penalty 1.5; the latter punishes repeated
# tokens, which is wrong for answers that repeat a citation per claim.
# LLM_REASONING_EFFORT=none switches Ollama's thinking off.
LLM_TEMPERATURE=0.0
LLM_TOP_P=1.0
LLM_PRESENCE_PENALTY=0.0
LLM_REASONING_EFFORT=none

# --- Prompt budget. Keep in step with num_ctx in ollama/Modelfile.
LLM_CONTEXT_TOKENS=8192
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TOKENIZER=Qwen/Qwen3.5-9B

# --- Judge LLM (phase 4). Deliberately a separate endpoint.
JUDGE_BASE_URL=http://localhost:11434/v1
JUDGE_MODEL=qwen3.5-9b-8k
JUDGE_API_KEY=ollama
JUDGE_REASONING_EFFORT=none
JUDGE_MAX_OUTPUT_TOKENS=1024
OLLAMA_API_URL=http://localhost:11434

# --- Vector store. Inside docker compose this is http://qdrant:6333
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=nsu_methodicals

# --- Models loaded in-process (phases 1c and 2). device: auto|mps|cuda|cpu
EMBEDDING_MODEL=intfloat/multilingual-e5-base
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
DEVICE=auto

# --- Paths, read as relative to the repository root.
RAW_DIR=data/raw
PARSED_DIR=data/parsed
COURSES_FILE=data/courses.yaml
MANIFEST_FILE=data/nsumedia-manifest.csv
INVENTORY_FILE=data/inventory.md
INVENTORY_COSTS_FILE=data/inventory-costs.json
PARSE_REPORT_FILE=data/parse-report.md
CHUNKS_FILE=data/chunks.jsonl
INGEST_REPORT_FILE=data/ingest-report.md
QUESTIONS_FILE=eval/questions.jsonl
EVAL_REPORTS_DIR=eval/reports
MANUAL_LABELS_FILE=eval/manual_labels.jsonl
MODELS_FILE=eval/models.yaml
EVAL_RUNS_DIR=data/eval-runs

# --- Parsing (phase 1b).
PARSE_WORKERS=2

# --- The full corpus (phase 4.5): see corpus.full.env.
# CORPUS_SCOPE: mvp|full; OCR_ENGINE: ocrmac|rapidocr
CORPUS_SCOPE=mvp
OCR_ENGINE=ocrmac

# --- Chunking and indexing (phase 1c).
CHUNK_TOKENS=400
CHUNK_OVERLAP_TOKENS=50
EMBED_BATCH_SIZE=32

# --- Retrieval (phase 2).
RETRIEVAL_CANDIDATES=50
RRF_K=60
RERANK_CANDIDATES=30
RERANKER_ENABLED=True

# --- Answering (phase 3). RETRIEVAL_MODE: bm25|dense|hybrid|hybrid+rerank
RETRIEVAL_MODE=hybrid+rerank
ANSWER_FRAGMENTS=10

# --- The agent (phase 5).
AGENT_MIN_SCORE=0.1
AGENT_MAX_REWRITES=2
AGENT_TOOL_ROUNDS=3
AGENT_TOOL_FRAGMENTS=3
AGENT_TOOL_TOKENS=1500

# --- Operational.
LOG_LEVEL=INFO
HEALTH_TIMEOUT_SECONDS=5.0
