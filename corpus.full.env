# The full corpus (phase 4.5): every unique document, scans OCR'd, in an index
# of its own - the MVP index stays as it is, for comparison. Pass this file to
# any command:
#
#   uv run --env-file corpus.full.env nsu-rag ocr        # hours; resumable
#   uv run --env-file corpus.full.env nsu-rag parse
#   uv run --env-file corpus.full.env nsu-rag ingest
#   uv run --env-file corpus.full.env nsu-rag eval --stage retrieval
#
# The parse cache (data/parsed/) is shared: it is keyed by content, so a
# document parsed for the MVP is not parsed again.
CORPUS_SCOPE=full
CHUNKS_FILE=data/chunks-full.jsonl
QDRANT_COLLECTION=nsu_methodicals_full
PARSE_REPORT_FILE=data/parse-report-full.md
INGEST_REPORT_FILE=data/ingest-report-full.md
